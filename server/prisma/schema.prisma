generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ApiKey {
  id           String    @id @default(uuid())
  name         String    @default("Default Key")
  user_id      String
  prefix       String
  value        String    @unique
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  last_used_at DateTime?
  revoked_at   DateTime?
  expires_at   DateTime?
}

model Playlist {
  id          String    @id @default(uuid())
  user_id     String
  name        String
  description String?
  limit       Int       @default(10) @map("playlist_limit")
  totalVideos Int?      @default(0)
  created_at  DateTime? @default(now()) @db.Timestamptz()

  @@map("playlist")
}

model Plan {
  id                     String    @id @default(uuid()) @db.Uuid
  user_id                String    @unique(map: "plan_user_id_uidx")
  name                   String
  stripe_customer_id     String?
  stripe_subscription_id String?
  created_at             DateTime? @db.Timestamptz()
  updated_at             DateTime? @db.Timestamptz()

  @@map("plan")
}

model Usage {
  id                     String    @id @default(uuid()) @db.Uuid
  user_id                String    @unique(map: "usage_user_id_uidx")
  storage_usage          BigInt?
  storage_limit          BigInt?
  minutes_streamed       BigInt?
  minutes_streamed_limit BigInt?
  created_at             DateTime? @db.Timestamptz()
  updated_at             DateTime? @db.Timestamptz()

  @@map("usage")
}

enum VideoStatus {
  PENDING
  PROCESSING
  READY
  FAILED

  @@map("video_status")
}

model VideoMetadata {
  id                   String      @id @default(uuid()) @db.Uuid
  user_id              String
  title                String
  description          String?
  videoFileName        String      @map("video_file_name")
  videoContentType     String      @map("video_content_type")
  videoSize            BigInt      @map("video_size")
  videoDuration        Float       @map("video_duration") @db.Real
  thumbnailFileName    String      @map("thumbnail_file_name")
  thumbnailContentType String      @map("thumbnail_content_type")
  thumbnailSize        BigInt      @map("thumbnail_size")
  tags                 String[]
  timestamps           String[]
  playlist_id          String?     @db.Uuid
  generateSubtitles    Boolean?    @default(false) @map("generate_subtitles")
  includeWatermark     Boolean?    @default(false) @map("include_watermark")
  videoTrackingId      String?     @map("video_tracking_id")
  thumbnailTrackingId  String?     @map("thumbnail_tracking_id")
  isPublic             Boolean     @default(false) @map("is_public")
  publicSlug           String?     @unique @map("public_slug")
  status               VideoStatus @default(PENDING)
  created_at           DateTime    @default(now()) @db.Timestamptz()
  updated_at           DateTime    @default(now()) @db.Timestamptz()

  @@map("video_metadata")
}

model PendingUploads {
  id         String   @id @default(uuid()) @db.Uuid
  video_id   String   @db.Uuid
  videoSize  BigInt   @map("video_size")
  started_at DateTime @default(now()) @db.Timestamptz()

  @@map("pending_uploads")
}

model TranscodingMetadata {
  id             String   @id @default(uuid()) @db.Uuid
  video_id       String   @db.Uuid
  fileCount      Int      @map("file_count")
  resolution     String[]
  totalSizeBytes BigInt   @map("total_size_bytes")
  status         String   @default("active")
  created_at     DateTime @default(now()) @db.Timestamptz()

  @@map("trancoding_metadata")
}

//////////////////////////////////////////////////////
// Platform Analytics
//////////////////////////////////////////////////////

model PlatformAnalytics {
  id            String @id @default(uuid())
  user_id       String
  totalRequests BigInt @default(0)

  created_at DateTime  @default(now()) @db.Timestamptz
  updated_at DateTime? @db.Timestamptz

  @@map("platform_analytics")
}

//////////////////////////////////////////////////////
// Video Analytics
//////////////////////////////////////////////////////

model VideoAnalytics {
  id                    String @id @default(uuid())
  video_id              String @unique
  minute_streamed       BigInt @default(0)
  totalViews            BigInt @default(0)
  uniqueViews           BigInt @default(0)
  average_view_duration Float  @default(0)

  geo    String[]
  device String[]

  created_at DateTime  @default(now()) @db.Timestamptz
  updated_at DateTime? @db.Timestamptz

  @@map("video_analytics")
}

//////////////////////////////////////////////////////
// Video Daily Analytics
//////////////////////////////////////////////////////

model VideoDailyAnalytics {
  id       String @id @default(uuid())
  video_id String @unique

  /// [{ date: "...", views: 100 }]
  views_last_28_days Json @default("[]")

  created_at DateTime  @default(now()) @db.Timestamptz
  updated_at DateTime? @db.Timestamptz

  @@map("video_daily_analytics")
}

//////////////////////////////////////////////////////
// Geo Analytics
//////////////////////////////////////////////////////

model GeoAnalytics {
  id      String @id @default(uuid())
  user_id String @unique

  /// [{ country: "...", views: 100 }]
  geo Json @default("[]")

  created_at DateTime  @default(now()) @db.Timestamptz
  updated_at DateTime? @db.Timestamptz

  @@map("geo_analytics")
}

//////////////////////////////////////////////////////
// Payment Invoices
//////////////////////////////////////////////////////

model PaymentInvoices {
  id String @id @default(uuid())

  user_id String

  stripe_customer_id     String?
  stripe_subscription_id String?

  stripe_invoice_id String @unique

  status   String?
  currency String?

  amount_due  BigInt?
  amount_paid BigInt?

  hosted_invoice_url String?
  invoice_pdf        String?

  period_start DateTime? @db.Timestamptz
  period_end   DateTime? @db.Timestamptz

  created_at DateTime  @default(now()) @db.Timestamptz
  updated_at DateTime? @db.Timestamptz

  @@map("payment_invoices")
}

//////////////////////////////////////////////////////
// Player Metadata
//////////////////////////////////////////////////////

model PlayerMetadata {
  id         String    @id @default(uuid())
  user_id    String    @unique
  settings   Json      @default("{}")
  created_at DateTime? @default(now()) @db.Timestamptz
  updated_at DateTime? @updatedAt @db.Timestamptz

  @@map("player_metadata")
}

//////////////////////////////////////////////////////
// Watermark Metadata
//////////////////////////////////////////////////////

model WatermarkMetadata {
  id             String    @id @default(uuid())
  user_id        String    @unique
  enabled        Boolean   @default(false)
  file_key       String?
  position       String    @default("bottom-right")
  opacity        Int       @default(50)
  last_upload_at DateTime? @db.Timestamptz
  created_at     DateTime? @default(now()) @db.Timestamptz
  updated_at     DateTime? @updatedAt @db.Timestamptz

  @@map("watermark_metadata")
}
