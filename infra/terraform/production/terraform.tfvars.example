motionmesh_nats_private_ip = "10.x.x.x"
motionmesh_redis_endpoint  = "motionmesh-prod.XXXXXXXXXX.aps1.cache.amazonaws.com"

clerk_publishable_key     = "pk_test_xxx"
clerk_secret_key          = "sk_test_xxx"
redis_key_secret          = "CHANGE_ME"
analytics_jwt_secret      = "CHANGE_ME"
