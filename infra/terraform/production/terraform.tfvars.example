motionmesh_api_key        = "CHANGE_ME"
motionmesh_bucket_id      = "CHANGE_ME"
motionmesh_transcode_bucket_id = "CHANGE_ME"
motionmesh_base_url       = "https://api.motionmesh.co.in/v1"

stripe_secret_key         = "sk_test_xxx"
