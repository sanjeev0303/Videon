aws_region                = "ap-south-1"
zone_name                 = "motionmesh.co.in"
domain_name               = "videon.motionmesh.co.in"
api_domain                = "api.videon.motionmesh.co.in"
vpc_cidr                  = "10.30.0.0/16"
azs                       = ["ap-south-1a", "ap-south-1b"]

db_name                   = "videon"
db_username               = "videon"
db_password               = "CHANGE_ME"

aurora_instance_class     = "db.t4g.medium"
api_instance_type         = "t3.medium"
client_instance_type      = "t3.small"
key_name                  = ""

github_repository         = "https://github.com/sanjeev0303/videon.git"
github_branch             = "main"
motionmesh_repository     = "https://github.com/sanjeev0303/motionmesh.git"

# Peering to motionmesh (shared NATS + Redis)
motionmesh_vpc_id          = "vpc-XXXXXXXXXXXX"
